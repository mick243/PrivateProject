# deploy/ncp/grafana-cloud.env — install-monitoring.sh 가 읽는 Grafana Cloud 접속 정보.
# 이 예시를 deploy/ncp/grafana-cloud.env 로 복사해 채우고 서버의 /root 로 올린다 (README §9).
# 그 사본은 커밋되지 않고(.gitignore) 배포 묶음에도 들어가지 않는다(build-release.sh). 서버에서 설치한 뒤에는 지운다.
#
# 값은 Grafana Cloud → 내 계정(grafana.com) → 스택 → Prometheus 의 "Details" 에 있다.

# "Remote Write Endpoint" — 끝이 /api/prom/push 인 주소
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-00-prod-ap-northeast-0.grafana.net/api/prom/push

# "Username / Instance ID" — 숫자
GRAFANA_CLOUD_PROM_USER=

# Access Policy 토큰 (glc_ 로 시작). 범위(scope)는 metrics:write 하나면 된다 — 같은 Details 화면의
# "Generate now" 로 만든 토큰도 된다. 토큰은 만들 때 한 번만 보인다. **실제 값은 이 견본이 아니라 사본에만.**
# (알림 규칙은 서버가 올리지 않고 Grafana Cloud 화면에서 가져온다 — README §9-4)
GRAFANA_CLOUD_TOKEN=
