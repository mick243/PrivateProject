# deploy/ncp/build.env — build-release.sh 가 **빌드할 때** 넣는 값. 복사해서 채우세요 (build.env 는 커밋되지 않습니다).
#
# 여기 들어가는 것은 전부 **공개되는 값**입니다 (NEXT_PUBLIC_* 는 브라우저로 나가고, APP_URL 은 주소).
# 비밀 키(API 시크릿 · DB 비밀번호 등)는 여기가 아니라 server.env 로 서버에 갑니다.

# 서비스 주소 — OG 이미지 · sitemap 의 절대 주소가 빌드 때 이 값으로 박힙니다
APP_URL=https://223-130-1-2.sslip.io

# 네이버 지도 키 ID — 빌드 시점에 번들에 들어갑니다. 바꾸면 다시 빌드해야 합니다
NEXT_PUBLIC_NAVER_MAP_KEY_ID=

# 이용약관 · 개인정보처리방침에 찍히는 운영자 정보 (비우면 화면에 자리표시자 경고가 보입니다)
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-10-01
