# /etc/systemd/system/arcade-traffic.service
#
#   systemctl start|stop|status arcade-traffic
#   journalctl -u arcade-traffic -f     ← 30초마다 요약 한 줄 (요청이 있었던 창만)
#
# Caddy 접근 로그(/var/log/caddy/arcade-finder.log)를 읽어 **사이트로 온 모든 요청**을 요청 수 지표로 바꿔
# Pulse 로 보냅니다 (scripts/caddy-traffic.mjs 머리말). 앱(arcade-finder.service)과 별개 프로세스라
# 앱이 죽어도 이쪽은 Caddy 가 대신 돌려준 502/503 을 그대로 셉니다.
#
# User=caddy 인 이유: Caddy 는 로그 파일을 기본 권한 600 으로 만들어서 caddy 사용자만 읽습니다.
# Caddyfile 을 고치지 않으려고 읽는 쪽이 caddy 로 돕니다. 이 프로세스는 네트워크로 Pulse 에만 나가고
# 파일은 읽기만 합니다(아래 보안 줄).
#
# 설정은 /etc/arcade-traffic.env (deploy/arcade-traffic.env.example). 없어도 돕니다 — Pulse 로 보내지 않고
# 요약만 journal 에 남깁니다. 앱의 .env.local 을 같이 읽지 않는 이유: 그 파일에는 DB 주소·API 키가 들어
# 있어서, caddy 사용자에게 읽힐 이유가 없습니다.

[Unit]
Description=오락실 파인더 요청 수 집계 (Caddy 로그 → Pulse)
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
EnvironmentFile=-/etc/arcade-traffic.env
ExecStart=/usr/bin/node /srv/arcade-finder/app/arcade-finder/scripts/caddy-traffic.mjs
Restart=always
RestartSec=5

# 1GB 서버(앱 + DB 가 피크에 515MB 쓴다)에서 이 프로세스가 커지는 일이 없게 천장을 둔다.
# 쉴 때 약 36MB (Windows 측정) — 경로 종류·표본에 상한이 있어 더 늘지 않는다.
MemoryMax=128M

# 보안 — 파일은 읽기만 하고 아무 데도 쓰지 않습니다.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
