# /etc/arcade-traffic.env  (root 소유 · chmod 600)   — arcade-traffic.service 가 읽는다
#
# 비워 두거나 이 파일을 안 만들어도 수집기는 돈다 (Pulse 로 안 보내고 요약만 journal 에).
# Pulse 로 보내려면 두 값이 다 있어야 한다.

# Pulse 수집 API 주소 — 앱 계측(.env.local 의 PULSE_API_URL)과 같은 값.
# 주소 끝의 슬래시는 있든 없든 된다. 이 서버에서 그 주소로 나갈 수 있어야 한다:
#   curl -s -o /dev/null -w '%{http_code}\n' "$PULSE_API_URL/health"
PULSE_API_URL=

# Pulse 대시보드에서 **새 AGENT 대상**(예: arcade-finder-edge)을 만들면 한 번 보여주는 키.
# 앱 계측의 PULSE_AGENT_KEY 와 같은 키를 쓰지 말 것 — 같은 대상에 섞으면 app.http.* 와 edge.req.* 가
# 한 차트에 뒤엉킨다.
PULSE_EDGE_KEY=

# 기본값 arcade-finder-edge. 바꾸면 Pulse 의 대상 이름과 맞출 필요는 없다 (키가 대상을 정한다).
# PULSE_EDGE_AGENT_ID=arcade-finder-edge

# 기본값 /var/log/caddy/arcade-finder.log (deploy/ncp/Caddyfile 의 log 블록)
# CADDY_LOG=/var/log/caddy/arcade-finder.log
