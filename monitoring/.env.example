# monitoring/.env — docker compose 가 읽는다. 이 사본(.env)은 커밋하지 않는다 (.gitignore)
#
#   cp .env.example .env    그리고 아래 두 값을 채운다

# 앱 .env.local 의 METRICS_TOKEN 과 **같은 값**. 만들기:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=

# postgres_exporter 가 붙을 개발 DB — 앱 .env.local 의 DATABASE_URL 에서 호스트만 host.docker.internal 로.
# (컨테이너 안의 localhost 는 컨테이너 자신이다.) 통계 뷰를 읽기만 한다.
PG_EXPORTER_DSN=postgresql://postgres:PASSWORD@host.docker.internal:5432/arcade_finder?sslmode=disable

# Grafana 관리자(대시보드 고칠 때 Sign in → admin). 비우면 admin — 127.0.0.1 에만 열리는 로컬이라
# GRAFANA_ADMIN_PASSWORD=

# 포트 — 3000 은 앱이 쓴다
# GRAFANA_PORT=3300
# PROMETHEUS_PORT=9090
