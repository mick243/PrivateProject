      "title": "5xx 비율",
      "description": "최근 5분 요청 중 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "(sum(rate(arcade_http_request_duration_seconds_count{job=\"arcade-finder\",status=~\"5..\"}[5m])) or vector(0)) / (sum(rate(arcade_http_request_duration_seconds_count{job=\"arcade-finder\"}[5m])) > 0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
