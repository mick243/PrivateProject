  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "앱 상태",
      "description": "수집기가 /api/metrics 를 긁을 수 있는가. \"내려감\"이면 앱이 꺼졌거나 METRICS_TOKEN 이 다릅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "min(up{job=\"arcade-finder\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "대상 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "내려감",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "정상",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      }
